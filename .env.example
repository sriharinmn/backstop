# PayPal sandbox app. Use a US sandbox business account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Only needed to verify webhooks on a public URL.
PAYPAL_WEBHOOK_ID=

# Free AI keys for the agent. Either one works.
GROQ_API_KEY=
GEMINI_API_KEY=

# AG Studio licence key. Without it, Studio shows a watermark.
AG_STUDIO=

# Optional Postgres connection string. Without it, data stays in a local PGlite database.
DATABASE_URL=
